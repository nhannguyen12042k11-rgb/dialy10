<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#ffffff">
<title>Ôn tập Địa lí 10</title>
<style>
  :root{
    --bg: #ffffff;
    --bg-soft: #f8fafc;
    --card: #ffffff;
    --ink: #0f172a;
    --ink-soft: #334155;
    --gray: #64748b;
    --line: #e2e8f0;
    --line-strong: #cbd5e1;
    --line-soft: #f1f5f9;
    --hover: #f8fafc;
    --chip-bg: #f1f5f9;
    --chip-ink: #475569;
    --blue: #2563eb;
    --blue-soft: #eff6ff;
    --blue-line: #bfdbfe;
    --green: #16a34a;
    --green-soft: #f0fdf4;
    --green-line: #bbf7d0;
    --red: #dc2626;
    --red-soft: #fef2f2;
    --red-line: #fecaca;
    --amber: #d97706;
    --amber-soft: #fef3c7;
    --amber-line: #fde68a;
    --shadow-sm: 0 1px 2px rgba(15,23,42,.05);
    --shadow: 0 4px 12px -4px rgba(15,23,42,.08), 0 2px 4px -2px rgba(15,23,42,.04);
    --radius: 14px;
  }
  [data-theme="dark"]{
    --bg: #0f172a;
    --bg-soft: #1e293b;
    --card: #1e293b;
    --ink: #f1f5f9;
    --ink-soft: #cbd5e1;
    --gray: #94a3b8;
    --line: #334155;
    --line-strong: #475569;
    --line-soft: #1e293b;
    --hover: #334155;
    --chip-bg: #334155;
    --chip-ink: #cbd5e1;
    --blue: #60a5fa;
    --blue-soft: #172554;
    --blue-line: #1e40af;
    --green: #4ade80;
    --green-soft: #052e16;
    --green-line: #166534;
    --red: #f87171;
    --red-soft: #450a0a;
    --red-line: #991b1b;
    --amber: #fbbf24;
    --amber-soft: #422006;
    --amber-line: #78350f;
    --shadow-sm: 0 1px 2px rgba(0,0,0,.35);
    --shadow: 0 4px 12px -4px rgba(0,0,0,.5), 0 2px 4px -2px rgba(0,0,0,.3);
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0}
  body{
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;
    font-size:15px;line-height:1.55;color:var(--ink);background:var(--bg-soft);
    min-height:100vh;-webkit-font-smoothing:antialiased;
    transition:background .2s, color .2s;
  }
  button{font-family:inherit;color:inherit}
  .wrap{max-width:680px;margin:0 auto;padding:20px 16px 120px}
  .screen{display:none}
  .screen.active{display:block}
  .head-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:4px 0 20px}
  .head-row h1{margin:0 0 4px;font-size:23px;font-weight:700;letter-spacing:-.4px}
  .head-row p{margin:0;color:var(--gray);font-size:14px}
  .head-row.small{padding:4px 0 14px}
  .head-row.small h1{font-size:19px;margin:0}
  .theme-btn{
    width:40px;height:40px;flex:0 0 auto;border:1px solid var(--line);
    border-radius:12px;background:var(--card);color:var(--ink);font-size:16px;
    cursor:pointer;display:grid;place-items:center;transition:.15s;box-shadow:var(--shadow-sm);
  }
  .theme-btn:hover{background:var(--hover)}
  .theme-btn:active{transform:scale(.96)}
  .password-wrap{max-width:360px;margin:0 auto;padding-top:40px}
  .password-icon{
    width:72px;height:72px;margin:0 auto 20px;border-radius:20px;
    display:grid;place-items:center;font-size:32px;
    background:var(--blue-soft);border:1px solid var(--blue-line);
  }
  .password-wrap h1{font-size:22px;margin:0 0 6px;text-align:center}
  .password-wrap > p{color:var(--gray);margin:0 0 24px;text-align:center;font-size:14px}
  .password-input{
    width:100%;padding:14px 16px;font-size:16px;
    border:1.5px solid var(--line-strong);border-radius:12px;
    background:var(--card);color:var(--ink);text-align:center;
    letter-spacing:6px;font-weight:600;outline:none;transition:.15s;font-family:inherit;
  }
  .password-input:focus{border-color:var(--blue);box-shadow:0 0 0 3px var(--blue-soft)}
  .password-error{color:var(--red);font-size:13px;margin:10px 0 0;text-align:center;min-height:20px}
  .box{
    border:1px solid var(--line);border-radius:var(--radius);padding:18px;
    margin-bottom:14px;background:var(--card);box-shadow:var(--shadow-sm);
    transition:background .2s, border-color .2s;
  }
  .box h2{margin:0 0 3px;font-size:15px;font-weight:700}
  .box .hint{margin:0 0 14px;font-size:13px;color:var(--gray)}
  .info-grid{display:flex;gap:8px}
  .info-cell{
    flex:1;text-align:center;border:1px solid var(--line);
    border-radius:11px;padding:12px 8px;background:var(--bg-soft);
  }
  .info-cell b{display:block;font-size:17px;font-weight:700;color:var(--blue);margin-bottom:2px}
  .info-cell span{font-size:12px;color:var(--gray)}
  .row{
    display:flex;align-items:center;gap:12px;padding:13px 0;
    border-bottom:1px solid var(--line-soft);cursor:pointer;
  }
  .row:last-of-type{border-bottom:none;padding-bottom:0}
  .row:first-of-type{padding-top:0}
  .row-txt{flex:1;min-width:0}
  .row-txt b{display:block;font-size:14.5px;font-weight:600}
  .row-txt small{display:block;font-size:12.5px;color:var(--gray);margin-top:1px}
  .row input{display:none}
  .toggle{
    width:42px;height:24px;border-radius:99px;background:var(--line-strong);
    position:relative;transition:.2s;flex:0 0 auto;
  }
  .toggle::after{
    content:'';position:absolute;top:3px;left:3px;width:18px;height:18px;
    border-radius:50%;background:#fff;transition:.2s;box-shadow:0 1px 2px rgba(0,0,0,.2);
  }
  .row input:checked + .toggle{background:var(--blue)}
  .row input:checked + .toggle::after{transform:translateX(18px)}
  .label{display:block;font-size:14px;font-weight:600;margin:0 0 10px}
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{
    padding:9px 15px;border-radius:10px;border:1px solid var(--line);
    background:var(--card);color:var(--chip-ink);font-size:13.5px;font-weight:500;
    cursor:pointer;transition:.15s;
  }
  .chip:hover{background:var(--hover)}
  .chip.active{border-color:var(--blue);background:var(--blue-soft);color:var(--blue);font-weight:600}
  .view-mode-list{display:flex;flex-direction:column;gap:8px}
  .view-mode-opt{
    display:flex;flex-direction:column;gap:3px;text-align:left;
    padding:13px 14px;border-radius:11px;border:1px solid var(--line);
    background:var(--card);cursor:pointer;transition:.15s;
  }
  .view-mode-opt:hover{background:var(--hover)}
  .view-mode-opt .vm-title{
    font-size:14.5px;font-weight:600;display:flex;align-items:center;gap:8px;flex-wrap:wrap;
  }
  .view-mode-opt .vm-badge{
    display:inline-block;font-size:10.5px;font-weight:700;
    padding:2px 8px;border-radius:99px;background:var(--blue-soft);color:var(--blue);
    letter-spacing:.3px;
  }
  .view-mode-opt .vm-sub{font-size:12.5px;color:var(--gray)}
  .view-mode-opt.active{border-color:var(--blue);background:var(--blue-soft)}
  .view-mode-opt.active .vm-title{color:var(--blue)}
  .view-mode-opt.active .vm-badge{background:var(--blue);color:#fff}
  .btn{
    padding:13px 20px;border-radius:12px;border:1px solid transparent;
    font-size:15px;font-weight:600;cursor:pointer;transition:.15s;flex:1;min-width:0;
  }
  .btn.primary{background:var(--blue);color:#fff;box-shadow:0 4px 12px -4px rgba(37,99,235,.4)}
  .btn.primary:hover{filter:brightness(1.05)}
  .btn.primary:active{transform:scale(.99)}
  .btn.plain{background:var(--card);border-color:var(--line-strong);color:var(--ink)}
  .btn.plain:hover{background:var(--hover)}
  .btn.plain:active{transform:scale(.99)}
  .btn:disabled{opacity:.4;cursor:not-allowed}
  .btn-block{width:100%;display:block;margin-top:16px}
  .note{
    font-size:13px;color:var(--gray);border:1px solid var(--line);
    border-radius:var(--radius);padding:13px 15px;margin-bottom:14px;
    background:var(--card);line-height:1.7;
  }
  .note b{color:var(--ink)}
  .topbar{position:sticky;top:0;z-index:30;background:var(--card);border-bottom:1px solid var(--line)}
  .topbar-inner{max-width:680px;margin:0 auto;padding:10px 16px;display:flex;align-items:center;gap:10px}
  .time{
    font-variant-numeric:tabular-nums;font-weight:700;font-size:14.5px;
    color:var(--blue);background:var(--blue-soft);padding:6px 12px;border-radius:9px;
  }
  .time.warn{color:var(--red);background:var(--red-soft)}
  .counter{flex:1;text-align:center;font-size:13.5px;font-weight:600;color:var(--gray)}
  .menu-btn{
    width:40px;height:40px;flex:0 0 auto;border:1px solid var(--line);
    border-radius:11px;background:var(--card);color:var(--ink);
    font-size:16px;cursor:pointer;display:grid;place-items:center;
  }
  .menu-btn:hover{background:var(--hover)}
  .bar{height:3px;background:var(--line-soft)}
  .bar-fill{height:100%;background:var(--blue);width:0;transition:width .3s}
  .part{
    display:inline-block;font-size:11px;font-weight:700;
    letter-spacing:.5px;padding:4px 10px;border-radius:6px;margin-bottom:10px;
  }
  .part.p1{background:var(--blue-soft);color:var(--blue)}
  .part.p2{background:var(--green-soft);color:var(--green)}
  .topic{font-size:12.5px;color:var(--gray);margin-bottom:12px}
  .qtext{
    margin:0 0 14px;padding:14px 16px;font-size:15.5px;font-weight:600;
    line-height:1.55;color:var(--ink);background:var(--bg-soft);
    border-left:3px solid var(--blue);border-radius:8px;
  }
  .opt{
    display:flex;gap:12px;align-items:flex-start;width:100%;text-align:left;
    padding:13px 14px;margin-bottom:9px;border:1.5px solid var(--line-strong);
    border-radius:11px;background:var(--card);font-size:14.8px;line-height:1.5;
    color:var(--ink);cursor:pointer;transition:.13s;
  }
  .opt:hover{background:var(--hover)}
  .opt:last-child{margin-bottom:0}
  .opt-letter{
    flex:0 0 auto;width:26px;height:26px;border-radius:50%;
    background:var(--chip-bg);color:var(--chip-ink);
    display:grid;place-items:center;font-size:12.5px;font-weight:700;
    margin-top:1px;transition:.13s;
  }
  .opt-body{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px}
  .opt-text{display:block}
  .opt-labels{display:flex;gap:6px;flex-wrap:wrap}
  .opt.selected{border-color:var(--blue);background:var(--blue-soft)}
  .opt.selected .opt-letter{background:var(--blue);color:#fff}
  .opt.correct{border-color:var(--green);background:var(--green-soft)}
  .opt.correct .opt-letter{background:var(--green);color:#fff}
  .opt.wrong{border-color:var(--red);background:var(--red-soft)}
  .opt.wrong .opt-letter{background:var(--red);color:#fff}
  .lbl{
    display:inline-block;font-size:10.5px;font-weight:700;
    padding:2px 8px;border-radius:5px;letter-spacing:.2px;line-height:1.4;white-space:nowrap;
  }
  .lbl-user{background:var(--amber-soft);color:var(--amber)}
  .lbl-correct{background:var(--green-soft);color:var(--green)}
  .lbl-muted{background:var(--chip-bg);color:var(--gray)}
  .passage{
    background:var(--bg-soft);border-left:3px solid var(--blue);
    border-radius:0 8px 8px 0;padding:13px 15px;font-size:13.8px;line-height:1.7;
    color:var(--ink-soft);margin:0 0 14px;
  }
  .passage.small{padding:11px 13px;font-size:13px;margin-bottom:12px}
  .tfrow{padding:13px 0;border-bottom:1px solid var(--line-soft)}
  .tfrow:last-child{border-bottom:none;padding-bottom:0}
  .tfrow:first-child{padding-top:0}
  .tflabel{font-size:14.5px;line-height:1.55;margin-bottom:10px}
  .tflabel b{color:var(--blue)}
  .tfbtns{display:flex;gap:8px}
  .tfbtn{
    flex:1;padding:11px;border-radius:10px;border:1.5px solid var(--line-strong);
    background:var(--card);color:var(--chip-ink);font-size:14px;font-weight:600;
    cursor:pointer;transition:.13s;
  }
  .tfbtn:hover{background:var(--hover)}
  .tfbtn.selected{background:var(--blue);border-color:var(--blue);color:#fff}
  .tfbtn.correct{background:var(--green-soft);border-color:var(--green);color:var(--green)}
  .tfbtn.wrong{background:var(--red-soft);border-color:var(--red);color:var(--red)}
  .tf-labels{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
  .foot{
    position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--card);
    border-top:1px solid var(--line);padding:10px 16px calc(10px + env(safe-area-inset-bottom));
  }
  .foot-inner{max-width:680px;margin:0 auto;display:flex;gap:8px}
  .foot .btn{padding:12px;font-size:14.5px}
  body.scroll-mode #btnPrev,
  body.scroll-mode #btnNext{display:none}
  body.scroll-mode #btnSubmit{flex:1}
  body.scroll-mode .qcard{scroll-margin-top:80px}
  .overlay{
    position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:40;
    opacity:0;pointer-events:none;transition:.2s;
  }
  .overlay.on{opacity:1;pointer-events:auto}
  .drawer{
    position:fixed;left:0;right:0;bottom:0;z-index:41;background:var(--card);
    border-radius:18px 18px 0 0;padding:18px 16px calc(18px + env(safe-area-inset-bottom));
    transform:translateY(105%);transition:.25s;max-height:78vh;
    display:flex;flex-direction:column;
  }
  .drawer.on{transform:translateY(0)}
  .drawer-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
  .drawer-hd h3{margin:0;font-size:15px}
  .drawer-hd button{
    border:none;background:var(--chip-bg);width:32px;height:32px;
    border-radius:50%;font-size:14px;cursor:pointer;color:var(--ink);
  }
  .grid{
    display:grid;grid-template-columns:repeat(auto-fill,minmax(44px,1fr));
    gap:6px;overflow-y:auto;padding:2px 0 6px;
  }
  .grid button{
    aspect-ratio:1;border-radius:9px;border:1px solid var(--line);
    background:var(--card);color:var(--chip-ink);font-size:13px;font-weight:600;
    cursor:pointer;transition:.13s;
  }
  .grid button:hover{background:var(--hover)}
  .grid button.answered{background:var(--blue-soft);border-color:var(--blue-line);color:var(--blue)}
  .grid button.cur{border-color:var(--blue);box-shadow:inset 0 0 0 1.5px var(--blue);color:var(--blue)}
  .grid .sep{
    grid-column:1/-1;font-size:11px;font-weight:700;color:var(--gray);
    letter-spacing:.5px;margin:6px 0 2px;
  }
  .modal{
    position:fixed;inset:0;z-index:60;display:grid;place-items:center;padding:20px;
    background:rgba(15,23,42,.5);opacity:0;pointer-events:none;transition:.18s;
  }
  .modal.on{opacity:1;pointer-events:auto}
  .modal-box{
    background:var(--card);border-radius:16px;padding:22px;width:100%;max-width:360px;
    box-shadow:0 20px 40px -12px rgba(15,23,42,.35);
  }
  .modal-box h3{margin:0 0 8px;font-size:16px}
  .modal-box p{margin:0 0 18px;font-size:14px;color:var(--gray)}
  .modal-actions{display:flex;gap:8px}
  .result-hero{padding:22px 18px 18px}
  .result-title{margin:0 0 20px;font-size:20px;font-weight:700;text-align:center;letter-spacing:-.3px}
  .charts-row{display:flex;gap:14px;justify-content:center;margin-bottom:18px}
  .chart{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;max-width:170px}
  .chart-svg-wrap{position:relative;width:100%;aspect-ratio:1;max-width:150px}
  .chart-svg-wrap svg{width:100%;height:100%;display:block;transform:rotate(-90deg)}
  .chart-track{fill:none;stroke:var(--line-soft);stroke-width:12}
  .chart-score-ring{
    fill:none;stroke:var(--blue);stroke-width:12;stroke-linecap:round;
    stroke-dasharray:314.16;stroke-dashoffset:314.16;
    transition:stroke-dashoffset 1.2s cubic-bezier(.22,1,.36,1);
  }
  .chart-seg{fill:none;stroke-width:12;transition:stroke-dasharray .8s cubic-bezier(.22,1,.36,1)}
  .chart-seg-correct{stroke:var(--green)}
  .chart-seg-wrong{stroke:var(--red)}
  .chart-center{
    position:absolute;inset:0;display:flex;flex-direction:column;
    align-items:center;justify-content:center;pointer-events:none;
  }
  .chart-val{font-size:26px;font-weight:800;letter-spacing:-1px;line-height:1;color:var(--ink)}
  .chart-val.small{font-size:22px}
  .chart-lbl{font-size:11.5px;color:var(--gray);font-weight:600;margin-top:3px}
  .chart-caption{font-size:12.5px;font-weight:600;color:var(--gray)}
  .breakdown{
    display:flex;justify-content:center;gap:6px;flex-wrap:wrap;
    padding:14px;background:var(--bg-soft);border-radius:12px;margin-bottom:16px;
  }
  .bd-item{display:flex;align-items:center;gap:6px;padding:6px 10px;font-size:13px}
  .bd-dot{width:10px;height:10px;border-radius:50%;flex:0 0 auto}
  .bd-green{background:var(--green)}
  .bd-red{background:var(--red)}
  .bd-gray{background:var(--line-strong)}
  .bd-lbl{color:var(--gray);font-weight:500}
  .bd-val{color:var(--ink);font-weight:700}
  .result-stats{display:flex;gap:8px;margin-bottom:16px}
  .result-stat{
    flex:1;text-align:center;padding:10px 6px;
    border:1px solid var(--line);border-radius:10px;
  }
  .result-stat b{display:block;font-size:15px;font-weight:700;color:var(--ink);margin-bottom:2px}
  .result-stat span{font-size:11.5px;color:var(--gray)}
  .result-actions{display:flex;gap:8px}
  .review-hd{
    display:flex;align-items:center;justify-content:space-between;
    margin:24px 0 12px;flex-wrap:wrap;gap:10px;
  }
  .review-hd h3{margin:0;font-size:16px}
  .ritem{padding:16px;margin-bottom:10px}
  .ritem-hd{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
  .ritem-num{font-size:12.5px;font-weight:700;color:var(--blue)}
  .tag{font-size:11px;font-weight:700;padding:3px 9px;border-radius:99px}
  .tag.ok{background:var(--green-soft);color:var(--green)}
  .tag.no{background:var(--red-soft);color:var(--red)}
  .ritem .qtext{font-size:14.5px;font-weight:600;margin-bottom:10px;padding:11px 13px}
  .ritem .opt{font-size:14px;padding:10px 12px;cursor:default}
  .ritem .opt:hover{background:var(--card)}
  .ritem .tflabel{font-size:14px}
  .ritem .tfbtn{cursor:default}
  .ritem .tfbtn:hover{background:var(--card)}
  .empty{text-align:center;color:var(--gray);font-size:14px;padding:26px 0}
</style>
</head>
<body>

<!-- ============ PASSWORD ============ -->
<section id="passwordScreen" class="screen active">
  <div class="wrap">
    <div class="password-wrap">
      <div class="password-icon">🔒</div>
      <h1>Nhập mật khẩu</h1>
      <p>Vui lòng nhập mật khẩu để vào bài ôn tập</p>
      <input type="password" id="passwordInput" class="password-input" placeholder="••••"
             autocomplete="off" autocapitalize="off" spellcheck="false">
      <div class="password-error" id="passwordError"></div>
      <button class="btn primary btn-block" id="btnPasswordSubmit">Vào bài</button>
    </div>
  </div>
</section>

<!-- ============ START ============ -->
<section id="startScreen" class="screen">
  <div class="wrap">
    <div class="head-row">
      <div>
        <h1>Ôn tập Địa lí 10</h1>
        <p>Trắc nghiệm nhiều lựa chọn &amp; trắc nghiệm đúng/sai</p>
      </div>
      <button class="theme-btn" data-theme-toggle aria-label="Chuyển giao diện">🌙</button>
    </div>
    <div class="box">
      <div class="info-grid">
        <div class="info-cell"><b>60</b><span>Câu trắc nghiệm</span></div>
        <div class="info-cell"><b>5</b><span>Câu đúng/sai</span></div>
        <div class="info-cell"><b>3</b><span>Chuyên đề</span></div>
      </div>
    </div>
    <div class="box">
      <h2>Cấu hình bài làm</h2>
      <p class="hint">Tuỳ chỉnh trước khi bắt đầu</p>
      <label class="row">
        <div class="row-txt">
          <b>Đảo đáp án</b>
          <small>Xáo trộn thứ tự các lựa chọn A, B, C, D</small>
        </div>
        <input type="checkbox" id="optShuffleAnswers">
        <span class="toggle"></span>
      </label>
      <label class="row">
        <div class="row-txt">
