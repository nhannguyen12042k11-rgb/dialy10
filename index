const $ = id => document.getElementById(id);
const shuffle = arr => {
  const a = arr.slice();
  for(let i = a.length - 1; i > 0; i--){
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
};
const fmtTime = s => {
  s = Math.max(0, Math.floor(s));
  return String(Math.floor(s/60)).padStart(2,'0') + ':' + String(s%60).padStart(2,'0');
};
const showScreen = id => {
  document.querySelectorAll('.screen').forEach(s => s.classList.toggle('active', s.id === id));
  window.scrollTo(0, 0);
};
const CIRCUMFERENCE = 2 * Math.PI * 50;

/* =========================================================
   THEME
   ========================================================= */
function applyTheme(theme){
  document.documentElement.setAttribute('data-theme', theme);
  try { localStorage.setItem('quiz-theme', theme); } catch(e){}
  document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
    btn.textContent = theme === 'dark' ? '☀️' : '🌙';
    btn.setAttribute('aria-label',
      theme === 'dark' ? 'Chuyển sang giao diện sáng' : 'Chuyển sang giao diện tối');
  });
  const meta = document.querySelector('meta[name="theme-color"]');
  if(meta) meta.setAttribute('content', theme === 'dark' ? '#0f172a' : '#ffffff');
}
function initTheme(){
  let saved = null;
  try { saved = localStorage.getItem('quiz-theme'); } catch(e){}
  applyTheme(saved === 'dark' ? 'dark' : 'light');
}
initTheme();
document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
  btn.addEventListener('click', () => {
    const cur = document.documentElement.getAttribute('data-theme') || 'light';
    applyTheme(cur === 'dark' ? 'light' : 'dark');
  });
});

/* =========================================================
   PASSWORD GATE
   ========================================================= */
const PASSWORD = 'C12';

function initPassword(){
  let authed = false;
  try { authed = sessionStorage.getItem('quiz-authed') === '1'; } catch(e){}
  if(authed){
    showScreen('startScreen');
    return;
  }
  showScreen('passwordScreen');
  setTimeout(() => { const el = $('passwordInput'); if(el) el.focus(); }, 100);
}
function tryPassword(){
  const input = $('passwordInput');
  const err = $('passwordError');
  const val = (input.value || '').trim();
  if(val === PASSWORD){
    err.textContent = '';
    try { sessionStorage.setItem('quiz-authed', '1'); } catch(e){}
    showScreen('startScreen');
  } else {
    err.textContent = 'Mật khẩu không đúng. Vui lòng thử lại.';
    input.select();
  }
}
$('btnPasswordSubmit').addEventListener('click', tryPassword);
$('passwordInput').addEventListener('keydown', (e) => {
  if(e.key === 'Enter'){ e.preventDefault(); tryPassword(); }
});
$('passwordInput').addEventListener('input', () => {
  const err = $('passwordError');
  if(err.textContent) err.textContent = '';
});

