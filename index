function buildItems(s){
  let mc = MC_DATA.map(q => ({
    type:'mc', part:1, topic:q.t, question:q.q,
    options: q.o.map((text, i) => ({ text, correct: i === q.a })),
    selected: null
  }));
  if(s.shuffleAnswers) mc.forEach(it => { it.options = shuffle(it.options); });
  if(s.shuffleQuestions) mc = shuffle(mc);

  let tf = TF_DATA.map(q => ({
    type:'tf', part:2, topic:q.t, passage:q.p,
    statements: q.s.map(st => ({ text: st.t, correct: st.a, selected: null }))
  }));
  if(s.shuffleQuestions) tf = shuffle(tf);

  return [...mc, ...tf];
}

function startQuiz(){
  state.items = buildItems(state.settings);
  state.index = 0;
  state.submitted = false;
  state.startedAt = Date.now();
  document.body.classList.toggle('scroll-mode', state.settings.viewMode === 'scroll');
  showScreen('quizScreen');
  if(state.settings.viewMode === 'single') renderQuestion();
  else renderAllQuestions();
  updateProgress();
  startTimer(state.settings.minutes);
}

/* =========================================================
   TIMER
   ========================================================= */
function startTimer(minutes){
  clearInterval(state.timerId);
  const el = $('timer');
  el.classList.remove('warn');
  if(!minutes){ el.textContent = '∞'; return; }
  state.remaining = minutes * 60;
  el.textContent = fmtTime(state.remaining);
  state.timerId = setInterval(() => {
    state.remaining--;
    el.textContent = fmtTime(state.remaining);
    if(state.remaining <= 60) el.classList.add('warn');
    if(state.remaining <= 0){
      clearInterval(state.timerId);
      doSubmit(true);
    }
  }, 1000);
}

/* =========================================================
   ANSWER STATE
   ========================================================= */
const isAnswered = it => it.type === 'mc'
  ? it.selected !== null
  : it.statements.every(s => s.selected !== null);

const isTouched = it => it.type === 'mc'
  ? it.selected !== null
  : it.statements.some(s => s.selected !== null);

const itemCorrect = it => it.type === 'mc'
  ? (it.selected !== null && !!it.options[it.selected].correct)
  : it.statements.every(s => s.selected === s.correct);

/* =========================================================
   BUILD CARD
   ========================================================= */
function buildCard(it, idx, review){
  const card = document.createElement('div');
  card.className = 'box';

  if(review){
    const head = document.createElement('div');
    head.className = 'ritem-hd';
    const num = document.createElement('span');
    num.className = 'ritem-num';
    num.textContent = 'Câu ' + (idx + 1) + (it.part === 1 ? ' · Trắc nghiệm' : ' · Đúng/Sai');
    const ok = itemCorrect(it);
    const tag = document.createElement('span');
    tag.className = 'tag ' + (ok ? 'ok' : 'no');
    tag.textContent = ok ? 'ĐÚNG' : 'SAI';
    head.append(num, tag);
    card.appendChild(head);
  }

  const part = document.createElement('div');
  part.className = 'part ' + (it.part === 1 ? 'p1' : 'p2');
  part.textContent = it.part === 1 ? 'PHẦN 1 · TRẮC NGHIỆM' : 'PHẦN 2 · ĐÚNG/SAI';
  card.appendChild(part);

  const topic = document.createElement('div');
  topic.className = 'topic';
  topic.textContent = TOPICS[it.topic];
  card.appendChild(topic);

  if(it.type === 'mc'){
    const q = document.createElement('p');
    q.className = 'qtext';
    q.textContent = it.question;
    card.appendChild(q);
    card.appendChild(buildMCOptions(it, review));
  } else {
    const ps = document.createElement('div');
    ps.className = 'passage';
    ps.textContent = it.passage;
    card.appendChild(ps);
    card.appendChild(buildTFStatements(it, review));
  }
  return card;
}

function buildMCOptions(it, review){
  const box = document.createElement('div');
  it.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'opt';

    const ltr = document.createElement('span');
    ltr.className = 'opt-letter';
    ltr.textContent = 'ABCD'[i];

    const body = document.createElement('span');
    body.className = 'opt-body';

    const txt = document.createElement('span');
    txt.className = 'opt-text';
    txt.textContent = opt.text;
    body.appendChild(txt);
    btn.append(ltr, body);

    if(review){
      btn.disabled = true;
      const isUserChoice = it.selected === i;
      const isCorrect = opt.correct;
      if(isCorrect) btn.classList.add('correct');
      if(isUserChoice && !isCorrect) btn.classList.add('wrong');

      const labels = document.createElement('span');
      labels.className = 'opt-labels';
      if(isUserChoice){
        const u = document.createElement('span');
        u.className = 'lbl lbl-user';
        u.textContent = 'Đáp án của bạn';
        labels.appendChild(u);
      }
      if(isCorrect){
        const c = document.createElement('span');
        c.className = 'lbl lbl-correct';
        c.textContent = 'Đáp án đúng';
        labels.appendChild(c);
      }
      if(labels.children.length) body.appendChild(labels);
    } else {
      if(it.selected === i) btn.classList.add('selected');
      btn.addEventListener('click', () => {
        it.selected = i;
        box.querySelectorAll('.opt').forEach(o => o.classList.remove('selected'));
        btn.classList.add('selected');
        updateProgress();
      });
    }
    box.appendChild(btn);
  });
  return box;
}

function buildTFStatements(it, review){
  const box = document.createElement('div');
  it.statements.forEach((st, i) => {
    const row = document.createElement('div');
    row.className = 'tfrow';

    const lb = document.createElement('div');
    lb.className = 'tflabel';
    const b = document.createElement('b');
    b.textContent = 'abcd'[i] + ') ';
    lb.append(b, document.createTextNode(st.text));
    row.appendChild(lb);

    const btns = document.createElement('div');
    btns.className = 'tfbtns';

    [{txt:'Đúng', val:true}, {txt:'Sai', val:false}].forEach(o => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'tfbtn';
      btn.textContent = o.txt;

      if(review){
        btn.disabled = true;
        if(st.correct === o.val) btn.classList.add('correct');
        if(st.selected === o.val && st.correct !== o.val) btn.classList.add('wrong');
      } else {
        if(st.selected === o.val) btn.classList.add('selected');
        btn.addEventListener('click', () => {
          st.selected = o.val;
          btns.querySelectorAll('.tfbtn').forEach(x => x.classList.remove('selected'));
          btn.classList.add('selected');
          updateProgress();
        });
      }
      btns.appendChild(btn);
    });

    row.appendChild(btns);

    if(review){
      const labels = document.createElement('div');
      labels.className = 'tf-labels';
      const user = document.createElement('span');
      user.className = 'lbl';
      if(st.selected === null){
        user.classList.add('lbl-muted');
        user.textContent = 'Bạn chọn: (chưa trả lời)';
      } else {
        user.classList.add('lbl-user');
        user.textContent = 'Bạn chọn: ' + (st.selected ? 'Đúng' : 'Sai');
      }
      labels.appendChild(user);
      const corr = document.createElement('span');
      corr.className = 'lbl lbl-correct';
      corr.textContent = 'Đáp án: ' + (st.correct ? 'Đúng' : 'Sai');
      labels.appendChild(corr);
      row.appendChild(labels);
    }
    box.appendChild(row);
  });
  return box;
}

/* =========================================================
   RENDER
   ========================================================= */
function renderQuestion(){
  const area = $('questionArea');
  area.innerHTML = '';
  area.appendChild(buildCard(state.items[state.index], state.index, false));
  updateNav();
}
function renderAllQuestions(){
  const area = $('questionArea');
  area.innerHTML = '';
  state.items.forEach((it, i) => {
    const card = buildCard(it, i, false);
    card.id = 'q-' + i;
    card.classList.add('qcard');
    area.appendChild(card);
  });
  updateNav();
}
function updateNav(){
  $('btnPrev').disabled = state.index === 0;
  $('btnNext').disabled = state.index === state.items.length - 1;
}
function updateProgress(){
  const total = state.items.length;
  const answered = state.items.filter(isAnswered).length;
  if(state.settings.viewMode === 'single'){
    $('progressText').textContent = `Câu ${state.index + 1}/${total}`;
  } else {
    $('progressText').textContent = `${answered}/${total} đã trả lời`;
  }
  $('progressFill').style.width = (answered / total * 100) + '%';
  buildPalette();
}
function buildPalette(){
  const p = $('palette');
  p.innerHTML = '';
  const mcCount = state.items.filter(x => x.part === 1).length;
  const isSingle = state.settings.viewMode === 'single';

  state.items.forEach((it, i) => {
    if(i === 0){
      const s = document.createElement('div');
      s.className = 'sep';
      s.textContent = 'PHẦN 1 · TRẮC NGHIỆM';
      p.appendChild(s);
    }
    if(i === mcCount){
      const s = document.createElement('div');
      s.className = 'sep';
      s.textContent = 'PHẦN 2 · ĐÚNG/SAI';
      p.appendChild(s);
    }
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = i + 1;
    if(isAnswered(it)) b.classList.add('answered');
    if(isSingle && i === state.index) b.classList.add('cur');
    b.addEventListener('click', () => {
      if(isSingle){
        state.index = i;
        renderQuestion();
        updateProgress();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        const el = $('q-' + i);
        if(el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      closeDrawer();
    });
    p.appendChild(b);
  });
}

/* =========================================================
   DRAWER / MODAL
   ========================================================= */
function openDrawer(){ $('drawer').classList.add('on'); $('drawerOverlay').classList.add('on'); }
function closeDrawer(){ $('drawer').classList.remove('on'); $('drawerOverlay').classList.remove('on'); }

let modalCallback = null;
function showModal(title, msg, onOk, okText){
  $('modalTitle').textContent = title;
  $('modalMsg').textContent = msg;
  $('modalOk').textContent = okText || 'Đồng ý';
  modalCallback = onOk;
  $('modal').classList.add('on');
}
function closeModal(){ $('modal').classList.remove('on'); modalCallback = null; }

/* =========================================================
   SUBMIT
   ========================================================= */
function requestSubmit(){
  const un = state.items.filter(it => !isAnswered(it)).length;
  const msg = un > 0
    ? `Còn ${un} câu chưa trả lời. Nộp bài ngay?`
    : 'Bạn đã hoàn thành tất cả câu hỏi. Nộp bài?';
  showModal('Nộp bài', msg, () => { closeDrawer(); doSubmit(false); }, 'Nộp bài');
}
function doSubmit(auto){
  if(state.submitted) return;
  state.submitted = true;
  clearInterval(state.timerId);
  state.elapsed = auto && state.settings.minutes
    ? state.settings.minutes * 60
    : Math.floor((Date.now() - state.startedAt) / 1000);
  renderResult();
  showScreen('resultScreen');
  closeModal();
  closeDrawer();
}

/* =========================================================
   RESULT
   ========================================================= */
function renderResult(){
  let mcOK = 0, mcTotal = 0, tfOK = 0, tfTotal = 0;
  let correct = 0, wrong = 0, unanswered = 0;
  const total = state.items.length;

  state.items.forEach(it => {
    if(it.type === 'mc'){
      mcTotal++;
      if(itemCorrect(it)) mcOK++;
    } else {
      it.statements.forEach(s => {
        tfTotal++;
        if(s.selected === s.correct) tfOK++;
      });
    }
    if(!isTouched(it)) unanswered++;
    else if(itemCorrect(it)) correct++;
    else wrong++;
  });

  const maxPoints = mcTotal + tfTotal * 0.5;
  const points = mcOK + tfOK * 0.5;
  const score10 = Math.round((points / maxPoints) * 100) / 10;

  $('scoreDisplay').textContent = score10.toFixed(1).replace('.0', '');
  $('totalCount').textContent = total;
  $('bdCorrect').textContent = correct;
  $('bdWrong').textContent = wrong;
  $('bdUnanswered').textContent = unanswered;
  $('mcScore').textContent = mcOK + '/' + mcTotal;
  $('tfScore').textContent = tfOK + '/' + tfTotal;
  $('timeUsed').textContent = fmtTime(state.elapsed);

  const scorePct = Math.max(0, Math.min(1, score10 / 10));
  const scoreRing = $('scoreRing');
  scoreRing.style.strokeDasharray = CIRCUMFERENCE;
  scoreRing.style.strokeDashoffset = CIRCUMFERENCE;
  requestAnimationFrame(() => {
    requestAnimationFrame(() => {
      scoreRing.style.strokeDashoffset = CIRCUMFERENCE * (1 - scorePct);
    });
  });

  const pctCorrect = total ? correct / total : 0;
  const pctWrong = total ? wrong / total : 0;
  const segC = $('segCorrect');
  const segW = $('segWrong');
  segC.setAttribute('transform', 'rotate(-90 60 60)');
  segW.setAttribute('transform', 'rotate(-90 60 60)');
  segC.style.strokeDasharray = `${CIRCUMFERENCE * pctCorrect} ${CIRCUMFERENCE}`;
  segC.style.strokeDashoffset = '0';
  segW.style.strokeDasharray = `${CIRCUMFERENCE * pctWrong} ${CIRCUMFERENCE}`;
  segW.style.strokeDashoffset = `${-CIRCUMFERENCE * pctCorrect}`;

  const title = $('resultTitle');
  if(score10 >= 8) title.textContent = 'Xuất sắc! 🎉';
  else if(score10 >= 6.5) title.textContent = 'Khá tốt! 👍';
  else if(score10 >= 5) title.textContent = 'Đạt yêu cầu 🙂';
  else title.textContent = 'Cần ôn tập thêm 💪';

  state.reviewFilter = 'all';
  document.querySelectorAll('#filterChips .chip').forEach(c =>
    c.classList.toggle('active', c.dataset.filter === 'all'));
  renderReview('all');
}

/* =========================================================
   REVIEW
   ========================================================= */
function renderReview(filter){
  const list = $('reviewList');
  list.innerHTML = '';
  let shown = 0;
  state.items.forEach((it, i) => {
    const ok = itemCorrect(it);
    if(filter === 'wrong' && ok) return;
    shown++;
    const card = buildCard(it, i, true);
    card.classList.add('ritem');
    list.appendChild(card);
  });
  if(shown === 0){
    const e = document.createElement('div');
    e.className = 'box empty';
    e.textContent = 'Không có câu nào sai. Tuyệt vời!';
    list.appendChild(e);
  }
}

/* =========================================================
   EVENTS
   ========================================================= */
document.querySelectorAll('#timerChips .chip').forEach(c => {
  c.addEventListener('click', () => {
    document.querySelectorAll('#timerChips .chip').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    state.settings.minutes = parseInt(c.dataset.min, 10);
  });
});

document.querySelectorAll('#viewModeChips .view-mode-opt').forEach(c => {
  c.addEventListener('click', () => {
    document.querySelectorAll('#viewModeChips .view-mode-opt').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    state.settings.viewMode = c.dataset.mode;
  });
});

$('btnStart').addEventListener('click', () => {
  state.settings.shuffleAnswers = $('optShuffleAnswers').checked;
  state.settings.shuffleQuestions = $('optShuffleQuestions').checked;
  startQuiz();
});
$('btnPrev').addEventListener('click', () => {
  if(state.settings.viewMode !== 'single') return;
  if(state.index > 0){
    state.index--;
    renderQuestion();
    updateProgress();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
});
$('btnNext').addEventListener('click', () => {
  if(state.settings.viewMode !== 'single') return;
  if(state.index < state.items.length - 1){
    state.index++;
    renderQuestion();
    updateProgress();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
});
$('btnSubmit').addEventListener('click', requestSubmit);
$('btnPalette').addEventListener('click', openDrawer);
$('drawerClose').addEventListener('click', closeDrawer);
$('drawerOverlay').addEventListener('click', closeDrawer);
$('modalCancel').addEventListener('click', closeModal);
$('modalOk').addEventListener('click', () => {
  const cb = modalCallback;
  closeModal();
  if(cb) cb();
});
$('btnRetake').addEventListener('click', startQuiz);
$('btnHome').addEventListener('click', () => {
  clearInterval(state.timerId);
  showScreen('startScreen');
});
document.querySelectorAll('#filterChips .chip').forEach(c => {
  c.addEventListener('click', () => {
    document.querySelectorAll('#filterChips .chip').forEach(x => x.classList.remove('active'));
    c.classList.add('active');
    state.reviewFilter = c.dataset.filter;
    renderReview(state.reviewFilter);
  });
});

window.addEventListener('beforeunload', e => {
  if(!state.submitted && state.items.length && $('quizScreen').classList.contains('active')){
    e.preventDefault();
    e.returnValue = '';
  }
});

/* =========================================================
   BOOT
   ========================================================= */
initPassword();
</script>
